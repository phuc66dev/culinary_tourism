# ==========================================
# ENVIRONMENT & RUNTIME
# ==========================================
APP_ENV=development
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==========================================
# DATABASE & CACHE
# ==========================================
MONGO_URI=mongodb://localhost:27017
DB_NAME=quan4_culinary
REDIS_URL=redis://localhost:6379/0

# ==========================================
# SECURITY & AUTHENTICATION
# ==========================================
JWT_SECRET=your_jwt_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
SECRET_KEY=your_secret_key_here
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep the same key for as long as encrypted CCCD records must remain readable.
FERNET_KEY=fernet_key_here

# Bootstrap Super Admin
SUPERADMIN_BOOTSTRAP_MODE=auto
SUPERADMIN_EMAIL=admin@quan4culinary.vn
SUPERADMIN_PASSWORD=ChangeMe123!

# ==========================================
# AI ADVISOR (GEMINI)
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
OWNER_DAILY_LIMIT=10

# ==========================================
# STATIC & MAP PACK PATHS
# ==========================================
STATIC_DIR=app/static
MAP_PACK_DATA_DIR=app/static/maps
# Optional Goong REST API key. Address lookup uses Photon when left blank.
GOONG_API_KEY=
PHOTON_BASE_URL=https://photon.komoot.io

# Cookie and security
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
