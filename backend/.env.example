# ==========================================
# ENVIRONMENT & RUNTIME
# ==========================================
APP_ENV=development
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==========================================
# DATABASE & CACHE
# ==========================================
MONGO_URI=mongodb://localhost:27017
DB_NAME=quan4_culinary
REDIS_URL=redis://localhost:6379/0

# ==========================================
# SECURITY & AUTHENTICATION
# ==========================================
JWT_SECRET=change_me_access_token_secret_key_min_32_chars
REFRESH_TOKEN_SECRET=change_me_refresh_token_secret_key_min_32_chars
SECRET_KEY=change_me_general_app_secret_key
# Khóa Fernet 32-byte base64 để mã hóa CCCD (PII Encryption at Rest)
FERNET_KEY=change_me_with_valid_fernet_base64_key_44_c=

# Bootstrap Super Admin
SUPERADMIN_BOOTSTRAP_MODE=auto
SUPERADMIN_EMAIL=admin@quan4culinary.vn
SUPERADMIN_PASSWORD=ChangeMe123!

# ==========================================
# AI ADVISOR (GEMINI 2.5 FLASH / PROXYPAL)
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
OWNER_DAILY_LIMIT=10

# ==========================================
# STATIC & MAP PACK PATHS
# ==========================================
STATIC_DIR=app/static
MAP_PACK_DATA_DIR=app/static/maps
